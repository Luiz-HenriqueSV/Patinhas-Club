# Copie este arquivo para ".env" (na mesma pasta) e ajuste.
PORTA=3000

# MySQL ou MariaDB (XAMPP: usuário root e senha vazia)
DB_HOST=localhost
DB_PORTA=3306
DB_USUARIO=root
DB_SENHA=
DB_NOME=patinhas

# Texto longo e aleatório (obrigatório em produção)
SESSAO_SEGREDO=troque-por-um-texto-grande-e-aleatorio

# E-mail de contato enviado ao OpenStreetMap nas buscas de endereço (política de uso do Nominatim)
CONTATO_EMAIL=

# Endereço público do site, usado nos links de e-mail (em produção)
URL_PUBLICA=

NODE_ENV=development
