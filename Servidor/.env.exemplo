# Copie este arquivo para ".env" (na mesma pasta) e ajuste. O iniciar.bat faz a cópia sozinho.
PORTA=3000

# Banco de dados:
#   embutido  SQLite que vem dentro do Node, não precisa instalar nada (arquivo dados/patinhas.db)
#   mysql     MySQL ou MariaDB de verdade (XAMPP), com os dados de acesso logo abaixo
BANCO=embutido
# BANCO_ARQUIVO=dados/patinhas.db

# Só para BANCO=mysql (XAMPP: usuário root e senha vazia)
DB_HOST=localhost
DB_PORTA=3306
DB_USUARIO=root
DB_SENHA=
DB_NOME=patinhas

# Texto longo e aleatório (obrigatório em produção)
SESSAO_SEGREDO=troque-por-um-texto-grande-e-aleatorio

# E-mail de contato enviado ao OpenStreetMap nas buscas de endereço (política de uso do Nominatim)
CONTATO_EMAIL=

# Endereço público do site, usado nos links de e-mail (em produção)
URL_PUBLICA=

NODE_ENV=development
